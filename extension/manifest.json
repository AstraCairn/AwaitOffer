{
  "manifest_version": 3,
  "name": "AwaitOffer · 日常 Edge 连接",
  "version": "0.3.7",
  "description": "在本机同步招聘进度，复用当前 Edge 的登录。无需读取或导出 Cookie、密码。",
  "key": "",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://*.jobs.feishu.cn/*",
    "https://*.mokahr.com/*",
    "https://*.zhiye.com/*",
    "https://we.zyt.com/*",
    "https://apply.careers.dji.com/*",
    "https://hr-campus.vivo.com/*",
    "https://career.huawei.com/*",
    "https://campus-talent.alibaba.com/*",
    "https://campus.kuaishou.cn/*",
    "https://jobs.mihoyo.com/*",
    "https://career.honor.com/*",
    "https://join.qq.com/*",
    "https://talent.lenovo.com.cn/*",
    "https://talent.baidu.com/*",
    "https://campus.jd.com/*",
    "https://talent.antgroup.com/*",
    "http://127.0.0.1:3182/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AwaitOffer"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.jobs.feishu.cn/*",
        "https://*.mokahr.com/*",
        "https://*.zhiye.com/*",
        "https://we.zyt.com/*",
        "https://apply.careers.dji.com/*",
        "https://hr-campus.vivo.com/*",
        "https://career.huawei.com/*",
        "https://campus-talent.alibaba.com/*",
        "https://campus.kuaishou.cn/*",
        "https://jobs.mihoyo.com/*",
        "https://career.honor.com/*",
        "https://join.qq.com/*",
        "https://talent.lenovo.com.cn/*",
        "https://talent.baidu.com/*",
        "https://campus.jd.com/*",
        "https://talent.antgroup.com/*"
      ],
      "js": [
        "capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.jobs.feishu.cn/*",
        "https://*.mokahr.com/*",
        "https://*.zhiye.com/*",
        "https://we.zyt.com/*",
        "https://apply.careers.dji.com/*",
        "https://hr-campus.vivo.com/*",
        "https://career.huawei.com/*",
        "https://campus-talent.alibaba.com/*",
        "https://campus.kuaishou.cn/*",
        "https://jobs.mihoyo.com/*",
        "https://career.honor.com/*",
        "https://join.qq.com/*",
        "https://talent.lenovo.com.cn/*",
        "https://talent.baidu.com/*",
        "https://campus.jd.com/*",
        "https://talent.antgroup.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:3182 ws://127.0.0.1:3182"
  }
}
